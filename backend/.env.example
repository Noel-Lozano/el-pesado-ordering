# Copy to backend/.env and fill in real values. Never commit .env.
# Every key here is checked at startup by src/config/env.ts.

NODE_ENV=development
PORT=4000

# Postgres connection string. For Supabase, use the Session Pooler string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/el_pesado

# Signs the session token issued after phone verification.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Twilio Verify, sending OTPs over WhatsApp only (ADR-003).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Verify service with the shop's WhatsApp sender attached (VA + 32 hex chars).
TWILIO_VERIFY_SERVICE_SID=

# Comma-separated frontend origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# Optional until Stripe payments are built (Phase 3). Leave commented out:
# an empty value fails validation, while an absent one is fine.
# STRIPE_SECRET_KEY=sk_test_...
