{
  // Typecheck-only config for one-off scripts (e.g. scripts/seed-menu.ts),
  // which import from src/ but are never compiled into dist.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["scripts/**/*.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "dist", "migrations"]
}
