{
  // Typecheck-only config for code that isn't built into dist: one-off
  // scripts (e.g. scripts/seed-menu.ts), tests, and vitest configs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true
  },
  "include": ["scripts/**/*.ts", "src/**/*.ts", "vitest*.config.ts"],
  "exclude": ["node_modules", "dist", "migrations"]
}
