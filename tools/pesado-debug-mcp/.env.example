# Copy to tools/pesado-debug-mcp/.env (gitignored) and fill in. Never commit .env.
# Each group is optional: a missing group disables only the tools that need it.

# GitHub tools (get_failed_runs, get_run_logs, get_failing_tests with source=ci).
# Fine-grained PAT scoped to this repository only: Actions read + Contents read.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Test database tools (reset_test_db, seed_test_data, rerun_test on integration files).
# Must point at a throwaway test DB, never production (ADR-007, three locks).
# Local default: docker compose -f docker-compose.test.yml up -d
PESADO_TEST_DATABASE_URL=
# Optional: one extra allowed host besides localhost / 127.0.0.1 / ::1,
# e.g. the Session Pooler host of a dedicated test-only Supabase project.
PESADO_TEST_DB_ALLOWED_HOST=

# Optional: repo root. Defaults to the folder that contains tools/.
PESADO_REPO_ROOT=
